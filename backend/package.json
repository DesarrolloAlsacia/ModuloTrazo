{
  "name": "trazo-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node src/app.js",
    "dev:docker": "nodemon --legacy-watch --watch src --ext js,json --signal SIGTERM --exec \"node src/app.js\"",
    "test": "node --test",
    "pm2:start": "node scripts/pm2.js start",
    "pm2:restart": "node scripts/pm2.js restart",
    "pm2:stop": "node scripts/pm2.js stop",
    "pm2:logs": "node scripts/pm2.js logs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mssql": "12.5.5",
    "pm2": "6.0.14"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
