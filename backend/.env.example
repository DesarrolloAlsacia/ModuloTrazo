# Copiar a backend/.env y completar. Nunca commitear el .env real.
# Si SQL Server está en la máquina anfitriona, usa host.docker.internal.
DB_SERVER=host.docker.internal
DB_PORT=1433
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

JWT_SECRET=cambia-este-secreto
IMPRESORA_AES_KEY=cambia-esta-clave
IMPRESION_API_URL=http://10.0.40.8:5015

# El compose fija el puerto 5173; no cambiar NEXO_PORT/PORT en Docker.
